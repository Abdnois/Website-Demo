---
import Base from "../layouts/Base.astro";
---

<Base title="Order confirmed">
  <section class="text-center py-24">
    <p class="text-6xl">🎉</p>
    <h1 class="text-3xl font-bold mt-4">Thank you for your order!</h1>
    <p class="text-gray-500 mt-2 max-w-md mx-auto">
      Your payment was successful and a confirmation email is on its way.
      (Demo mode — no real charge was made.)
    </p>
    <a href="/products" class="inline-block mt-8 bg-brand text-white font-semibold px-6 py-3 rounded-xl hover:bg-brand-dark transition-colors">
      Continue shopping
    </a>
  </section>
</Base>
