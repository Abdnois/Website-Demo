---
import Base from "../../layouts/Base.astro";
import { site, formatPrice } from "../../data/site";

export function getStaticPaths() {
  return site.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Base title={product.name} description={product.description}>
  <div class="grid gap-8 md:grid-cols-2">
    <img
      src={product.image}
      alt={product.name}
      class="rounded-xl border border-gray-200 aspect-square w-full object-cover"
    />
    <div class="flex flex-col">
      <p class="text-sm uppercase tracking-wide text-brand font-semibold">
        {product.category}
      </p>
      <h1 class="text-3xl font-bold mt-1">{product.name}</h1>
      <p class="text-2xl font-bold mt-3">{formatPrice(product.price, site.currency)}</p>
      <p class="text-gray-600 mt-4">{product.description}</p>
      <button
        class="mt-8 bg-brand text-white font-semibold px-6 py-3 rounded-xl hover:bg-brand-dark transition-colors w-fit"
        data-add-to-cart
        data-id={product.id}
      >
        Add to cart
      </button>
      <a href="/products" class="mt-4 text-sm text-gray-500 hover:text-brand">← Back to shop</a>
    </div>
  </div>

  <script>
    const btn = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
    btn?.addEventListener("click", () => {
      const id = btn.dataset.id!;
      const raw = localStorage.getItem("cart");
      const cart: Record<string, number> = raw ? JSON.parse(raw) : {};
      cart[id] = (cart[id] ?? 0) + 1;
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
      btn.textContent = "Added ✓";
      setTimeout(() => (btn.textContent = "Add to cart"), 1200);
    });
  </script>
</Base>
