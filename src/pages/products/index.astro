---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { site, type Category } from "../../data/site";

const { category } = Astro.url.searchParams;
const valid = site.categories.some((c) => c.id === category);
const products = valid
  ? site.products.filter((p) => p.category === (category as Category))
  : site.products;
---

<Base title="Shop">
  <h1 class="text-3xl font-bold mb-2">Shop</h1>
  <p class="text-gray-500 mb-6">{products.length} products</p>

  <div class="flex flex-col sm:flex-row gap-3 mb-8">
    <input
      id="search"
      type="search"
      placeholder="Search products…"
      class="flex-1 border border-gray-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand"
    />
    <div class="flex gap-2 flex-wrap">
      <a
        href="/products"
        class={`px-3 py-2 rounded-full text-sm border ${!valid ? "bg-brand text-white border-brand" : "border-gray-300 hover:border-brand"}`}
      >
        All
      </a>
      {
        site.categories.map((c) => (
          <a
            href={`/products?category=${c.id}`}
            class={`px-3 py-2 rounded-full text-sm border ${category === c.id ? "bg-brand text-white border-brand" : "border-gray-300 hover:border-brand"}`}
          >
            {c.label}
          </a>
        ))
      }
    </div>
  </div>

  <div id="grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {products.map((product) => <ProductCard product={product} currency={site.currency} />)}
  </div>
  <div id="no-results" class="hidden text-center text-gray-500 py-16">
    No products match your search. <a href="/products" class="text-brand hover:underline">Clear filters</a>
  </div>

  <script>
    const input = document.getElementById("search") as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#grid > article"));
    const noResults = document.getElementById("no-results")!;

    input?.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      let visible = 0;
      for (const card of cards) {
        const text = card.textContent?.toLowerCase() ?? "";
        const show = text.includes(q);
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      noResults.classList.toggle("hidden", visible > 0);
    });
  </script>
</Base>
