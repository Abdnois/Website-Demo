---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { site, type Category } from "../../data/site";

const { category } = Astro.url.searchParams;
const valid = site.categories.some((c) => c.id === category);
const products = valid
  ? site.products.filter((p) => p.category === (category as Category))
  : site.products;
---

<Base title="Shop">
  <h1 class="text-3xl font-bold mb-2">Shop</h1>
  <div class="flex gap-2 mb-8">
    <a
      href="/products"
      class={`px-3 py-1.5 rounded-full text-sm border ${!valid ? "bg-brand text-white border-brand" : "border-gray-300 hover:border-brand"}`}
    >
      All
    </a>
    {
      site.categories.map((c) => (
        <a
          href={`/products?category=${c.id}`}
          class={`px-3 py-1.5 rounded-full text-sm border ${category === c.id ? "bg-brand text-white border-brand" : "border-gray-300 hover:border-brand"}`}
        >
          {c.label}
        </a>
      ))
    }
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      products.map((product) => (
        <ProductCard product={product} currency={site.currency} />
      ))
    }
  </div>
</Base>
