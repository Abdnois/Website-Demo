---
import { formatPrice, type Product } from "../data/site";

interface Props {
  product: Product;
  currency: string;
}

const { product, currency } = Astro.props;
const onSale = product.compareAtPrice !== undefined && product.compareAtPrice > product.price;
const discount = onSale ? Math.round((1 - product.price / product.compareAtPrice!) * 100) : 0;
const badgeClass = product.badge === "Sale" ? "bg-red-500 text-white" : product.badge === "New" ? "bg-brand text-white" : "bg-amber-400 text-gray-900";
const badgeLabel = product.badge === "Sale" ? "-" + discount + "%" : (product.badge ?? "");
const stockText = product.stock <= 10 ? "Only " + product.stock + " left" : "";
const stockVisible = product.stock <= 10;
---

<article class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all flex flex-col group">
  <a href={`/products/${product.slug}`} class="relative block overflow-hidden">
    <img
      src={product.images[0]}
      alt={product.name}
      class="aspect-square w-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <div class="absolute top-3 left-3 flex gap-2">
      {product.badge && <span class={badgeClass}>{badgeLabel}</span>}
    </div>
    {stockVisible && <span class="absolute bottom-3 left-3 text-xs font-medium bg-white/90 px-2 py-1 rounded-full text-red-600">{stockText}</span>}
  </a>
  <div class="p-4 flex flex-col flex-1">
    <div class="flex items-center gap-1 text-sm text-amber-500">
      {"★".repeat(Math.round(product.rating))}
      <span class="text-gray-400 text-xs ml-1">({product.reviews})</span>
    </div>
    <a href={`/products/${product.slug}`} class="font-semibold mt-1 hover:text-brand">
      {product.name}
    </a>
    <p class="text-sm text-gray-500 mt-1 flex-1 line-clamp-2">{product.description}</p>
    <div class="mt-3 flex items-center justify-between">
      <div class="flex items-baseline gap-2">
        <span class="font-bold">{formatPrice(product.price, currency)}</span>
        {
          onSale && (
            <span class="text-sm text-gray-400 line-through">
              {formatPrice(product.compareAtPrice!, currency)}
            </span>
          )
        }
      </div>
      <button
        class="bg-brand text-white text-sm font-medium px-3 py-1.5 rounded-lg hover:bg-brand-dark transition-colors"
        data-add-to-cart
        data-id={product.id}
      >
        Add to cart
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.id!;
      const raw = localStorage.getItem("cart");
      const cart: Record<string, number> = raw ? JSON.parse(raw) : {};
      cart[id] = (cart[id] ?? 0) + 1;
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
      btn.textContent = "Added ✓";
      setTimeout(() => (btn.textContent = "Add to cart"), 1200);
    });
  });
</script>
