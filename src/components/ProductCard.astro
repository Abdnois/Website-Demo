---
import { formatPrice, type Product } from "../data/site";

interface Props {
  product: Product;
  currency: string;
}

const { product, currency } = Astro.props;
---

<article class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
  <a href={`/products/${product.slug}`}>
    <img src={product.image} alt={product.name} class="aspect-square w-full object-cover" loading="lazy" />
  </a>
  <div class="p-4 flex flex-col flex-1">
    <a href={`/products/${product.slug}`} class="font-semibold hover:text-brand">
      {product.name}
    </a>
    <p class="text-sm text-gray-500 mt-1 flex-1">{product.description}</p>
    <div class="mt-3 flex items-center justify-between">
      <span class="font-bold">{formatPrice(product.price, currency)}</span>
      <button
        class="bg-brand text-white text-sm font-medium px-3 py-1.5 rounded-lg hover:bg-brand-dark transition-colors"
        data-add-to-cart
        data-id={product.id}
        data-name={product.name}
      >
        Add to cart
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.id!;
      const raw = localStorage.getItem("cart");
      const cart: Record<string, number> = raw ? JSON.parse(raw) : {};
      cart[id] = (cart[id] ?? 0) + 1;
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
      btn.textContent = "Added ✓";
      setTimeout(() => (btn.textContent = "Add to cart"), 1200);
    });
  });
</script>
