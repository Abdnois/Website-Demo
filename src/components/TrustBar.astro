---
import { site } from "../data/site";
---

<section class="grid grid-cols-2 md:grid-cols-4 gap-4 my-12">
  {
    site.trust.map((t) => (
      <div class="bg-white border border-gray-200 rounded-xl p-4 text-center">
        <div class="text-2xl">{t.icon}</div>
        <p class="font-semibold text-sm mt-1">{t.title}</p>
        <p class="text-xs text-gray-500 mt-0.5">{t.text}</p>
      </div>
    ))
  }
</section>
