---
import { site } from "../data/site";
---

<section class="my-16">
  <h2 class="text-2xl font-bold text-center mb-8">What customers say</h2>
  <div class="grid gap-6 md:grid-cols-3">
    {
      site.testimonials.map((t) => (
        <figure class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col">
          <div class="text-amber-500">★★★★★</div>
          <blockquote class="text-gray-600 text-sm mt-3 flex-1">"{t.text}"</blockquote>
          <figcaption class="mt-4 text-sm">
            <span class="font-semibold">{t.name}</span>
            <span class="text-gray-400"> — {t.location}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
