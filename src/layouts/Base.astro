---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-gray-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} image={image} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛍️</text></svg>" />
  </head>
  <body class="min-h-full flex flex-col text-gray-900">
    <div class="bg-brand-dark text-white text-center text-sm py-2 px-4">
      {site.announcement}
    </div>
    <Header />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      const updateBadge = () => {
        const raw = localStorage.getItem("cart");
        const cart: Record<string, number> = raw ? JSON.parse(raw) : {};
        const count = Object.values(cart).reduce((a, b) => a + b, 0);
        const el = document.querySelector<HTMLElement>("[data-cart-count]");
        if (el) el.textContent = String(count);
      };
      updateBadge();
      window.addEventListener("cart:updated", updateBadge);
    </script>
  </body>
</html>
